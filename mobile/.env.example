EXPO_PUBLIC_API_URL=http://localhost:8000

# mock  — development-only demo adapter (default in dev builds, no backend needed)
# live  — talk to the real API at EXPO_PUBLIC_API_URL
# Release builds always use `live`, whatever is set here.
EXPO_PUBLIC_API_MODE=mock

EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_LIVEKIT_URL=
