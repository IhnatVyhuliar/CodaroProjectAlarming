  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testPathIgnorePatterns": ["/node_modules/", "\\.node\\.test\\.[jt]sx?$"]
      },
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testEnvironmentOptions": { "customExportConditions": [""] },
        "testMatch": ["**/*.node.test.[jt]s?(x)"],
        "transform": {
          "^.+\\.[jt]sx?$": ["babel-jest", { "presets": ["babel-preset-expo"] }]
        },
        "transformIgnorePatterns": ["node_modules/(?!(expo)/)"]
      }
    ]
  }
}
