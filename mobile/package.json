    "expo-image-manipulator": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
